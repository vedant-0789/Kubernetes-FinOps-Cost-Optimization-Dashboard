# Copy to .env and adjust. Never commit real secrets.
FINOPS_ENVIRONMENT=prod
FINOPS_LOG_LEVEL=INFO
FINOPS_LOG_JSON=true
FINOPS_SEED_DEMO_DATA=true
FINOPS_CORS_ORIGINS=http://localhost:8080
FINOPS_COLLECTION_INTERVAL_SECONDS=30
FINOPS_AUTH_REQUIRED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FINOPS_JWT_SECRET=change-me-to-a-long-random-string
FINOPS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FINOPS_BOOTSTRAP_ADMIN_PASSWORD=change-me-please-123
